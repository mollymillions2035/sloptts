{
  "manifest_version": 3,
  "name": "Kokoro TTS (sloptts)",
  "version": "1.0.0",
  "description": "Kokoro voices for Chrome's Reading mode and the Web Speech API, from the local Kokoro server",
  "key": "",
  "permissions": ["ttsEngine", "nativeMessaging"],
  "background": {"service_worker": "background.js"},
  "tts_engine": {
    "voices": [
      {"voice_name": "Kokoro Heart (not Google)", "lang": "en-US", "event_types": ["start", "end", "word", "error"]},
      {"voice_name": "Kokoro Bella (not Google)", "lang": "en-US", "event_types": ["start", "end", "word", "error"]},
      {"voice_name": "Kokoro Michael (not Google)", "lang": "en-US", "event_types": ["start", "end", "word", "error"]},
      {"voice_name": "Kokoro Fenrir (not Google)", "lang": "en-US", "event_types": ["start", "end", "word", "error"]},
      {"voice_name": "Kokoro Emma (not Google)", "lang": "en-GB", "event_types": ["start", "end", "word", "error"]},
      {"voice_name": "Kokoro George (not Google)", "lang": "en-GB", "event_types": ["start", "end", "word", "error"]}
    ]
  }
}
